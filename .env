# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=news
DB_USER=postgres
DB_PASSWORD=password

# Broker configuration
BROKER_URL=amqp://guest:guest@rabbitmq:5672/

# RSS feeds (comma separated)
